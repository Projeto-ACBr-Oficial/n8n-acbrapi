# Copy to .env — .env is not versioned.
#   cp .env.example .env

# Required by the local n8n container. Without it, credentials saved in n8n
# become unreadable once the container is recreated. Generate your own:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-this-value

# info | debug — use debug when investigating how the node is loaded
N8N_LOG_LEVEL=info

# all | none — see the security note in the README: when testing the certificate
# operation, the A1 file and its password travel through the workflow and are
# written to the execution data.
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all

# ACBr API credentials do NOT go here. They are created in the n8n UI, under
# Credentials -> ACBr API OAuth2 API, so that the token lives in the credential
# store and is reused — which is what keeps you under the 4 requests/hour limit
# of the token endpoint.
